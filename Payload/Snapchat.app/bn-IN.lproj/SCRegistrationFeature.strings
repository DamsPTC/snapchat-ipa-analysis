"user_agreement_linking" = "চালিয়ে যান ট্যাপ করার মাধ্যমে, আপনি স্বীকার করছেন যে আপনি %1$@ পড়েছেন এবং %2$@-তে সম্মত হয়েছেন।";
"user_agreement_linking_EuUk_t1" = "Snapchat ব্যক্তিগত পছন্দ অনুযায়ী দেওয়া একটি পরিষেবা। আপনি কীভাবে এটি ব্যবহার করেন তার উপর ভিত্তি করে আমরা আপনাকে এমন জিনিস দেখাই যা আমরা মনে করি আপনার পছন্দ হবে। আপনাকে ব্যক্তিগতভাবে পছন্দসই বিজ্ঞাপন দেখানোর জন্য আমরা কিছু তথ্য (এবং অন্যদের কাছ থেকে পাওয়া এমন তথ্য) ব্যবহার করি, যা আমাদের কমিউনিটিকে Snapchat বিনামূল্যে ব্যবহার করার ক্ষেত্রে সাহায্য করে। [%1$@]\n\nচালিয়ে যান ট্যাপ করে, আপনি স্বীকার করছেন যে আপনি %2$@টি পড়েছেন এবং%3$@-তে সম্মত হচ্ছেন৷";
"user_agreement_linking_EuUk_t2" = "চালিয়ে যান ট্যাপ করার মাধ্যমে, আপনি স্বীকার করছেন যে আপনি %1$@টি পড়েছেন এবং %2$@-এর সাথে সম্মত হচ্ছেন৷ \n\nSnapchat ব্যক্তিগত পছন্দ অনুযায়ী দেওয়া একটি পরিষেবা যা আপনার ব্যবহারের উপর ভিত্তি করে আপনাকে কন্টেন্ট এবং বিজ্ঞাপনগুলি দেখায়।";
"user_agreement_linking_Quebec" = "আমরা আমাদের গোপনীয়তার নীতি এবং %1$@-এর বর্ণনা অনুযায়ী, আপনার অ্যাকাউন্ট ব্যক্তিগতভাবে পছন্দসই করে তোলা ও বিজ্ঞাপন দেখানো সহ, সেটি তৈরি করা ও আমাদের পরিষেবা দেওয়া এবং Snapchat-কে নিরাপদ ও সুরক্ষিত রাখতে সাহায্য করার জন্য আপনার তথ্য ব্যবহার করি। অ্যাকাউন্টের তথ্য অ্যাক্সেস করতে, ম্যানেজ করতে এবং মুছতে বা আপনার পছন্দগুলি অ্যাডজাস্ট করতে আমরা আপনার অ্যাপ সেটিংসে টুল দিয়ে থাকি৷ \n\nচালিয়ে যান-এ ট্যাপ করার মাধ্যমে, আপনি স্বীকার করছেন যে আপনি %2$@ পড়েছেন এবং %3$@-তে সম্মত হয়েছেন।";
