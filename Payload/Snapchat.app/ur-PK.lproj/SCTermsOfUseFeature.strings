"tos_update_13_header" = "👋 ہم اپنی [سروس کی شرائط](https://www.snap.com/terms/)، [Snapchat+‎ سبسکرپشن کی شرائط](https://www.snap.com/terms/paid-features)، [ٹوکنز کی فروخت اور استعمال کی شرائط](https://www.snap.com/terms/paid-features) اور [پرائیویسی پالیسی](https://values.snap.com/privacy/privacy-policy) اپ ڈیٹ کر رہے ہیں، ان اپ ڈیٹس کا اطلاق 15 اگست، 2023 سے ہوگا۔";
"tos_update_13_privacy_content" = " • وضاحت کی ہے کہ ہم آپ کی معلومات کس طرح استعمال کرتے ہیں بشمول یہ کہ اپنی سروسز کو ذاتی نوعیت کا بنانے، تحقیق انجام دینے اور الگورتھمز اور مشین لرننگ ماڈلز بنانے کا ہمارا طریقہ کار کیا ہے۔\n • ہمارے [پرائیویسی سینٹر](https://values.snap.com/privacy/privacy-center) میں نئے صفحہ کا لنک فراہم کیا ہے جو بیان کرتا ہے کہ ہم تشہیر کیلئے آپ کا ڈیٹا کس طرح استعمال کرتے ہیں نیز آپ کے پاس دستیاب انتخابات کی وضاحت کرتا ہے۔\n • اس بارے میں مزید شفافیت فراہم کی ہے کہ ہم مواد کس طرح اکٹھا اور استعمال کرتے ہیں۔ مثلاً، اگر آپ Spotlight پر باسکٹ بال کی ویڈیوز پوسٹ کرتے ہیں تو ہم آپ کو باسکٹ بال سے متعلق زیادہ مواد دکھا سکتے ہیں۔";
"tos_update_13_terms_content" = " • امریکی لازمی ثالثی کے معاہدے، کلاس ایکشن اور عدالتی مقدمہ کی معافی کو اپ ڈیٹ کیا گیا ہے اور غیر رسمی تنازعہ کے حل کی دفعہ شامل کی گئی ہے۔\n • وضاحت کی گئی ہے کہ ہم اپنی شرائط میں تبدیلیاں کب کریں گے اور کب آپ کو ان تبدیلیوں سے مطلع کریں گے۔\n • یورپی ڈیجیٹل سروسز ایکٹ کے تقاضے پورے کرنے میں مدد کیلئے، ہم نے ذاتی نوعیت کا بنانے کے عمل، مواد کی ماڈریشن اور استعمال کی شرائط کے نفاذ سے متعلق اپنی حکمت عملی کے بارے میں اضافی معلومات فراہم کی ہیں۔";
"tos_update_14_acceptance_footer" = "'اتفاق کریں اور جاری رکھیں' پر ٹیپ کرنے کا مطلب ہے کہ آپ ہماری اپ ڈیٹ شدہ [سروس کی شرائط](https://www.snap.com/terms) اور [بامعاوضہ فیچرز کی شرائط](https://snap.com/terms/paid-features) سے متفق ہیں اور تسلیم کرتے/کرتی ہیں کہ آپ نے اپ ڈیٹ شدہ [پرائیویسی پالیسی](https://values.snap.com/privacy/privacy-policy) پڑھ لی ہے۔ 26 فروری، 2024 سے، جب تک آپ ان اپ ڈیٹ شدہ شرائط سے اتفاق نہ کر لیں آپ Snapchat استعمال نہیں کر پائیں گے/گی۔";
