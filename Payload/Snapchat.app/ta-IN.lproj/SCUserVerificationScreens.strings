"ngo_phone_number_info_receive_messaging_by_channel" = "SMS சரிபார்ப்புக் குறியீட்டை அனுப்புவோம். உங்கள் எண்ணை உள்ளிடுவதன் மூலம், SMS அல்லது பிற செய்தி அனுப்பும் சேனல் மூலம் உங்கள் கணக்கைப் பற்றிய பரிவர்த்தனை செய்தியைப் பெற ஒப்புக்கொள்கிறீர்கள்.";
"ngo_phone_number_info_receive_messaging_by_channel_and_more" = "சரிபார்ப்புக் குறியீட்டை நாங்கள் உங்களுக்கு அனுப்புவோம். உங்கள் கைபேசி எண்ணை உள்ளிடுவதன் மூலம், உங்கள் கணக்கு மற்றும் பலவற்றைப் பற்றிய பரிவர்த்தனைச் செய்தியைக் குறுஞ்செய்தி அல்லது பிற செய்தியனுப்பும் சேனல்கள் மூலமாகப் பெறுவீர்கள்.";
"ngo_phone_number_info_receive_messaging_by_channel_learn_more" = "சரிபார்ப்புக் குறியீட்டை உங்களுக்கு அனுப்புவோம். உங்கள் கைபேசி எண்ணை உள்ளிடுவதன் மூலம், உங்கள் கணக்கு குறித்த பரிவர்த்தனைச் செய்திகளைக் குறுஞ்செய்தி அல்லது பிற செய்தியனுப்பும் சேனல் மூலம் பெற ஒப்புக்கொள்கிறீர்கள். உங்கள் கைபேசி எண்ணை Snap எப்படிப் பயன்படுத்துகிறது என்பதைப் பற்றி [மேலும் தெரிந்துகொள்ளுங்கள்](https://help.snapchat.com/hc/articles/7012351597076?utm_source=sc&utm_medium=lm&utm_campaign=mobile_number).";
