"tos_update_13_acceptance_footer" = "\"ஏற்றுக்கொண்டு, தொடர்க\" என்பதைத் தட்டுவதன் மூலம், எங்களின் புதுப்பிக்கப்பட்ட [சேவை விதிமுறைகள்](https://www.snap.com/terms/), [Snapchat+ சந்தா விதிமுறைகள்](https://www.snap.com/terms/paid-features), [டோக்கன்களின் விற்பனை மற்றும் பயன்படுத்தல் விதிமுறைகளை](https://www.snap.com/terms/paid-features) ஒப்புக்கொள்கிறீர்கள், மேலும் புதுப்பிக்கப்பட்ட [தனியுரிமைக் கொள்கையைப்](https://values.snap.com/privacy/privacy-policy) படித்ததாக ஒப்புக்கொள்கிறீர்கள். ஆகஸ்ட் 15, 2023 முதல், இந்தப் புதுப்பிக்கப்பட்ட விதிமுறைகளை நீங்கள் ஏற்கும் வரை உங்களால் Snapchat ஐப் பயன்படுத்த முடியாது.";
"tos_update_13_body" = "அனைத்து மாற்றங்களையும் புரிந்துகொள்ள, புதுப்பிப்புகளை முழுமையாகப் படிக்கவும். நாங்கள் செய்துள்ள சில முக்கிய மாற்றங்கள் இங்கே கொடுக்கப்பட்டுள்ளன:";
"tos_update_13_header" = "👋 எங்கள் [சேவை விதிமுறைகள்](https://www.snap.com/terms/), [Snapchat+ சந்தா விதிமுறைகள்](https://www.snap.com/terms/paid-features), [டோக்கன்களின் விற்பனை மற்றும் பயன்பாட்டு விதிமுறைகள்](https://www.snap.com/terms/paid-features) மற்றும் [தனியுரிமைக் கொள்கை](https://values.snap.com/privacy/privacy-policy) ஆகியவற்றைப் புதுப்பித்துள்ளோம், இது ஆகஸ்ட் 15, 2023 முதல் நடைமுறைக்கு வரும்.";
"tos_update_13_privacy_content" = " • எங்கள் சேவைகளை நாங்கள் எப்படித் தனிப்பயனாக்குகிறோம், ஆராய்ச்சி நடத்துகிறோம் மற்றும் அல்காரிதங்களையும் இயந்திரக் கற்றல் மாதிரிகளையும் எப்படி உருவாக்குகிறோம் என்பது உட்பட உங்கள் தகவலை நாங்கள் எப்படிப் பயன்படுத்துகிறோம் என்பதைத் தெளிவுபடுத்தியுள்ளோம்.\n • எங்கள் [தனியுரிமை மையத்தில்](https://values.snap.com/privacy/privacy-center) உள்ள ஒரு புதிய பக்கத்துடன் இணைத்துள்ளோம், இது விளம்பரத்திற்காக உங்கள் தரவை நாங்கள் எப்படிப் பயன்படுத்துகிறோம் என்பதை விளக்குகிறது மற்றும் உங்களுக்கான வாய்ப்புகளைத் தெளிவுபடுத்துகிறது.\n • உள்ளடக்கத்தை எப்படிச் சேகரித்துப் பயன்படுத்துகிறோம் என்பதில் அதிக வெளிப்படைத்தன்மையை வழங்குகிறோம். எடுத்துக்காட்டாக, நீங்கள் ஸ்பாட்லைட்டில் கூடைப்பந்து வீடியோக்களை இடுகையிட்டால், நாங்கள் உங்களுக்கு கூடைப்பந்து தொடர்பான உள்ளடக்கத்தை அதிகம் காட்டக்கூடும்.";
"tos_update_13_terms_content" = " • அமெரிக்க கட்டாய நடுவர் தீர்ப்பு ஒப்பந்தம், பிரதிநிதித்துவ நடவடிக்கை மற்றும் ஜூரி விசாரணை விலக்கு ஆகியவற்றைப் புதுப்பித்து, முறைசாரா சர்ச்சையைத் தீர்க்கும் விதியைச் சேர்த்துள்ளோம்.\n • எங்களின் விதிமுறைகளில் எப்போது மாற்றங்களைச் செய்வோம் என்றும், இந்த மாற்றங்களை உங்களுக்கு எப்போது அறிவிப்போம் என்றும் தெளிவுபடுத்தியுள்ளோம்.\n • ஐரோப்பிய டிஜிட்டல் சேவைகள் சட்டத்தின் தேவைகளைப் பூர்த்தி செய்வதற்கு உதவும் விதமாக, தனிப்பயனாக்கம், உள்ளடக்கத்தை மதிப்பிடுதல் மற்றும் பயன்படுத்தல் விதிமுறைகளை அமலாக்குவதற்கான எங்கள் அணுகுமுறை பற்றிய கூடுதல் தகவல்களை வழங்கியுள்ளோம்.";
"tos_update_14_acceptance_footer" = "\"ஏற்றுக்கொண்டு தொடர்க\" மீது தட்டுவதன் மூலம், எங்களது புதுப்பிக்கப்பட்ட [சேவை நிபந்தனைகள்](https://www.snap.com/terms) மற்றும் [கட்டண அம்சங்களின் விதிமுறைகளை](https://snap.com/terms/paid-features), நீங்கள் ஏற்றுக்கொண்டு புதுப்பிக்கப்பட்ட [தனியுரிமைக் கொள்கையை](https://values.snap.com/privacy/privacy-policy)நீங்கள் படித்துவிட்டதாகவும் ஒப்புக்கொள்கிறீர்கள். பிப்ரவரி 26, 2024 முதலாக, இந்தப் புதுப்பிக்கப்பட்ட விதிமுறைகளை ஏற்காமல் உங்களால் Snapchat பயன்படுத்த முடியாது.";
"tos_update_14_body" = "புதுப்பிப்புகளை முழுமையாகப் படித்துப் பார்க்கவும். நாங்கள் செய்துள்ள சில முக்கிய மாற்றங்கள் இங்கே கொடுக்கப்பட்டுள்ளன:";
"tos_update_14_header" = "எங்களது [தனியுரிமைக் கொள்கை](https://values.snap.com/privacy/privacy-policy) மற்றும் [சேவை நிபந்தனைகளைப்](https://www.snap.com/terms) புதுப்பித்துவருகிறோம். இது பிப்ரவரி 26, 2024 முதல் நடைமுறைக்கு வரும்.";
"tos_update_14_india_blurb" = "Snapchat பயனர்கள் அனைவரும் எங்கள் [சமூக வழிகாட்டுதல்கள்](https://values.snap.com/privacy/transparency/community-guidelines) உட்பட எங்கள் சேவை நிபந்தனைகளுக்குக் கட்டாயம் இணங்க வேண்டும். சட்ட விரோதமான காரணங்களுக்காக Snapchat ஐக் கட்டாயம் பயன்படுத்தக்கூடாது, அத்துடன் இந்தியாவில் இந்தியத் தொழில்நுட்ப விதிகள் 2021 ஐ மீறும் உள்ளடக்கத்தை அனுப்பவோ இடுகையிடவோ Snapchat ஐப் பயன்படுத்த கூடாது.\n\n";
"tos_update_14_privacy_content" = " • தனியுரிமையின் ஒவ்வொரு பிரிவுக்கும் அவற்றை எளிதில் புரிந்துகொள்ளும் வகையில் சுருக்கங்கள் சேர்க்கப்பட்டுள்ளன.\n • உங்கள் தரவுகளைப் பதிவிறக்குவது, உள்ளடக்கத்தை யாருடன் பகிர்கிறீர்கள், யார் உங்களைத் தொடர்புகொள்ளலாம் என்பவை உட்பட உங்கள் தகவல்களை நீங்கள் எவ்வாறு கட்டுப்படுத்துவது என்பவை பற்றிய கூடுதல் விபரங்கள்.\n • உங்கள் தகவல்களையும் உள்ளடக்கத்தையும் நாங்கள் எவ்வாறு சேகரித்து பயன்படுத்துகிறோம் என்பதில், தனிப்பயனாக்கம், விளம்பரம், இயந்திரக் கற்றல் மாதிரிகளை உருவாக்குவது போன்ற நோக்கங்களுக்காக எத்தகைய தரவுகளை நாங்கள் பயன்படுத்துகிறோம் என்பதற்கான உதாரணங்களுடன் கூடுதல் வெளிப்படைத்தன்மை.";
"tos_update_14_terms_content" = " • மேலும், Snap என்பது ஒரு தனிப்பயனாக்கப்பட்ட சேவை என்பது தெளிவுபடுத்தப்பட்டுள்ளது.\n • நீங்கள் ஆசிய பசிபிக் பிராந்தியத்தில் வசிப்பவர் எனில், உங்களுக்கு சேவைகளை வழங்கும் பொறுப்பு Snap Group Limited-இன் சிங்கப்பூர் கிளையைச் சேர்ந்தது.\n • Snapchat+ விதிமுறைகள், டோக்கன்கள், ஸ்ட்ரீக் மீட்டமைப்பு ஆகியவற்றுக்கான விதிமுறைகள் இப்போது புதிய [கட்டண அம்சங்களின் விதிமுறைகளில்](https://snap.com/terms/paid-features) சேர்க்கப்பட்டுள்ளன.";
