"user_agreement_info_dialog_description" = "Snapchat உங்களுக்கு ஏற்ற அனுபவத்தை வழங்குகிறது. இது உங்களுக்கென்ற தனிப்பயானக்கப்பட்டு நாங்கள் பெறும் தகவல்களின்படி வழங்கப்படுகிறது. Snapchat மூலம் நாங்கள் சேகரிக்கும் தகவல்கள் மற்றும் விளம்பரதாரர்கள் மூலம் நாங்கள் பெறக்கூடிய தகவல்கள் ஆகியவற்றின் அடிப்படையில் நாங்கள் விளம்பரங்களைக் காட்டுகிறோம். இந்த வகையில் நமது சமூகத்திடம் கட்டணம் வசூலிக்காமல் தொடர்ந்து எங்களால் Snapchat சேவையை வழங்க முடியும்.";
"user_agreement_info_dialog_title" = "தனிப்பயனாக்கப்பட்ட சேவை";
"user_agreement_linking" = "'தொடர்க' என்பதைத் தட்டுவதன் மூலம், நீங்கள் %1$@ ஐப் படித்துவிட்டீர்கள் என்றும் %2$@ ஐ ஏற்கிறீர்கள் என்றும் ஒப்புக்கொள்கிறீர்கள்.";
"user_agreement_linking_EuUk_t1" = "Snapchat என்பது தனிப்பயனாக்கப்பட்ட சேவையாகும். நீங்கள் எப்படிப் பயன்படுத்துகிறீர்கள் என்பதன் அடிப்படையில் நீங்கள் விரும்பக்கூடும் என்று நாங்கள் நினைக்கும் விஷயங்களை உங்களுக்குக் காட்டுகிறோம். தனிப்பயனாக்கப்பட்ட விளம்பரங்களை உங்களுக்குக் காட்ட சில தகவல்களை (மற்றும் பிறர் வழங்கக்கூடிய தகவல்) நாங்கள் பயன்படுத்துகிறோம், இது நமது சமூகத்திற்கு Snapchat ஐ இலவசமாக வழங்க உதவுகிறது. [%1$@]\n\nதொடர்க என்பதைத் தட்டுவதன் மூலம், நீங்கள் %2$@ ஐப் படித்து, %3$@ ஐ ஒப்புக்கொள்கிறீர்கள்.";
"user_agreement_linking_EuUk_t2" = "தொடர்க மீது தட்டுவதன் மூலம், நீங்கள் %1$@ஐ வாசித்துள்ளதை ஒப்புக்கொள்வதுடன் %2$@ ஏற்கிறீர்கள்.\n\nSnapchat என்பது ஒரு தனிப்பயனாக்கச் சேவை. இது நீங்கள் பயன்படுத்துவதன் அடிப்படையில் உங்களுக்கு உள்ளடக்கங்களையும் விளம்பரங்களையும் காட்டுகிறது.";
"user_agreement_linking_Quebec" = "எங்கள் தனியுரிமைக் கொள்கை மற்றும் %1$@ இல் விவரிக்கப்பட்டுள்ளபடி (உங்கள் கணக்கை உருவாக்குதல், தனிப்பயனாக்கம் மற்றும் விளம்பரங்கள் உட்பட எங்கள் சேவைகளை வழங்குதல் மற்றும் Snapchat ஐப் பாதுகாப்பாக வைத்திருக்க உதவுதல் போன்றவை) உங்கள் தகவலைப் பயன்படுத்துகிறோம். கணக்குத் தகவலை அணுக, நிர்வகிக்க மற்றும் நீக்க அல்லது உங்கள் விருப்பத்தேர்வுகளைச் சரிசெய்ய உங்கள் செயலி அமைப்புகளில் கருவிகளை வழங்குகிறோம்.\n\n'தொடர்க' என்பதைத் தட்டுவதன் மூலம், நீங்கள் %2$@ ஐப் படித்துவிட்டீர்கள் என்பதையும் %3$@ ஐ ஏற்கிறீர்கள் என்பதையும் ஒப்புக்கொள்கிறீர்கள்.";
