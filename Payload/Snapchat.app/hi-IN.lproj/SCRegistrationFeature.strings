"user_agreement_linking" = "'जारी रखें' पर टैप करने का मतलब है कि आप मानते हैं कि आपने %1$@ को पढ़ लिया है और आप %2$@ से सहमत हैं।";
"user_agreement_linking_EuUk_t1" = "Snapchat एक व्यक्तिगत सेवा है। इसके ज़रिए हम आपको आपकी पसंद की चीज़ें दिखाने की कोशिश करते हैं। आपको मनपसंद विज्ञापन दिखाने के लिए हम थोड़ी-बहुत जानकारी (और दूसरों से मिल सकने वाली जानकारी) का भी इस्तेमाल करते हैं, जो हमें अपनी कम्युनिटी को Snapchat की सेवाएं मुफ़्त देने में मदद करती है। [%1$@]\n\n जारी रखें पर टैप करने का मतलब है कि आप स्वीकार करते हैं कि आपने %2$@ को पढ़ लिया है और %3$@ से सहमत हैं।";
"user_agreement_linking_EuUk_t2" = "'जारी रखें' पर टैप करने का मतलब है कि आप स्वीकार करते हैं कि आपने %1$@ को पढ़ लिया है और %2$@ से सहमत हैं।\n\nSnapchat एक व्यक्तिगत सेवा है, जो उसे इस्तेमाल करने के तरीके के आधार पर आपको कॉन्टेंट और विज्ञापन दिखाती है।";
"user_agreement_linking_Quebec" = "हम आपकी जानकारी को हमारी गोपनीयता नीति और %1$@ के दिशानिर्देशों के अनुसार इस्तेमाल करते हैं, जैसे कि आपका अकाउंट बनाने में, अपनी सेवाएं देने में, जिसमें पर्सनलाइज़ करना और विज्ञापन शामिल है। साथ ही, Snapchat को सुरक्षित और महफ़ूज़ रखने में मदद के लिए भी आपकी जानकारी का इस्तेमाल किया जाता है। अपनी ऐप सेटिंग में टूल्स की मदद से आप अकाउंट से जुड़ी जानकारी को एक्सेस, मैनेज और डिलीट कर सकते हैं या अपनी प्राथमिकताओं को एडजस्ट कर सकते हैं।\n\n'जारी रखें' पर टैप करने का मतलब है कि स्वीकार करते हैं कि आपने %2$@ को पढ़ लिया है और %3$@ से सहमत हैं।";
