"payouts_push_notification_subtitle_onboarded" = "வாழ்த்துக்கள்! உங்களுடைய வருவாய்களைக் காண, தகவல் குறிப்புப் பக்கத்தில் உள்ள என் பணம் வழங்கல்கள் என்பதைப் பாருங்கள்!";
