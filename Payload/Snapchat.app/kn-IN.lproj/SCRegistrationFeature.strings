"user_agreement_info_dialog_description" = "Snapchat ನಿಮಗೆ ವೈಯಕ್ತಿಕಗೊಳಿಸಿದ ಅನುಭವವನ್ನು ನೀಡುತ್ತದೆ, ಇದು ನಿಮಗೆ ವಿಶಿಷ್ಟವಾಗಿರುತ್ತದೆ ಮತ್ತು ನಮಗೆ ದೊರೆಯುವ ಮಾಹಿತಿಯಿಂದ ಚಾಲಿತವಾಗಿದೆ. ನಾವು Snapchat ನಲ್ಲಿ ಸಂಗ್ರಹಿಸುವ ಮಾಹಿತಿ ಮತ್ತು ನಾವು ಜಾಹೀರಾತುದಾರರಿಂದ ಸ್ವೀಕರಿಸಬಹುದಾದ ಮಾಹಿತಿಯನ್ನು ಆಧರಿಸಿ ನಿಮಗೆ ಉದ್ದೇಶಿತ ಜಾಹೀರಾತನ್ನು ತೋರಿಸುತ್ತೇವೆ. ಈ ರೀತಿಯಾಗಿ ನಾವು Snapchat ಅನ್ನು ನಮ್ಮ ಕಮ್ಯುನಿಟಿಗೆ ಉಚಿತವಾಗಿ ಒದಗಿಸಲು ಸಾಧ್ಯವಾಗುತ್ತದೆ.";
"user_agreement_info_dialog_title" = "ವೈಯಕ್ತಿಕಗೊಳಿಸಿದ ಸೇವೆ";
"user_agreement_linking" = "ಮುಂದುವರಿಯಿರಿ ಎಂಬುದನ್ನು ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ, ನೀವು %1$@ ಅನ್ನು ಓದಿದ್ದೀರಿ ಮತ್ತು %2$@ ಅನ್ನು ಒಪ್ಪುತ್ತೀರಿ ಎಂದು ಅಂಗೀಕರಿಸುತ್ತೀರಿ.";
"user_agreement_linking_EuUk_t1" = "Snapchat ಒಂದು ವೈಯಕ್ತಿಕಗೊಳಿಸಿದ ಸೇವೆಯಾಗಿದೆ. ನೀವು ಅದನ್ನು ಹೇಗೆ ಬಳಕೆ ಮಾಡುತ್ತೀರಿ ಎಂಬುದರ ಆಧಾರದ ಮೇಲೆ ನಿಮಗೆ ಇಷ್ಟವಾಗಬಹುದೆಂದು ನಾವು ಭಾವಿಸುವ ವಿಷಯಗಳನ್ನು ನಾವು ನಿಮಗೆ ತೋರಿಸುತ್ತೇವೆ. ನಿಮಗೆ ವೈಯಕ್ತಿಕಗೊಳಿಸಿದ ಜಾಹೀರಾತುಗಳನ್ನು ತೋರಿಸಲು ನಾವು ಕೆಲವು ಮಾಹಿತಿಯನ್ನು (ಮತ್ತು ಇತರರು ಒದಗಿಸಬಹುದಾದ ಮಾಹಿತಿಯನ್ನು) ಸಹ ಬಳಸುತ್ತೇವೆ. ಇದು Snapchat ಅನ್ನು ನಮ್ಮ ಕಮ್ಯುನಿಟಿಗೆ ಉಚಿತವಾಗಿ ಒದಗಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ. [%1$@]\n\nಮುಂದುವರಿಯಿರಿ ಎಂಬುದನ್ನು ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ ನೀವು %2$@ ಅನ್ನು ಓದಿದ್ದೀರಿ ಮತ್ತು %3$@ ಅನ್ನು ಒಪ್ಪುತ್ತೀರಿ ಎಂದು ಅಂಗೀಕರಿಸುತ್ತೀರಿ.";
"user_agreement_linking_EuUk_t2" = "ಮುಂದುವರಿಯಿರಿ ಎಂಬುದನ್ನು ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ, ನೀವು %1$@ ಅನ್ನು ಓದಿದ್ದೀರಿ ಮತ್ತು %2$@ ಅನ್ನು ಒಪ್ಪುತ್ತೀರಿ ಎಂದು ಅಂಗೀಕರಿಸುತ್ತೀರಿ.\n\nSnapchat ಒಂದು ವೈಯಕ್ತಿಕಗೊಳಿಸಿದ ಸೇವೆಯಾಗಿದ್ದು, ನೀವು ಅದನ್ನು ಹೇಗೆ ಬಳಕೆ ಮಾಡುತ್ತೀರಿ ಎಂಬುದರ ಆಧಾರದ ಮೇಲೆ ಅದು ನಿಮಗೆ ಕಂಟೆಂಟ್ ಮತ್ತು ಜಾಹೀರಾತುಗಳನ್ನು ತೋರಿಸುತ್ತದೆ.";
"user_agreement_linking_Quebec" = "ನಮ್ಮ ಗೌಪ್ಯತೆ ನೀತಿ ಮತ್ತು %1$@ ರಲ್ಲಿ ವಿವರಿಸಿದಂತೆ ನಾವು ನಿಮ್ಮ ಮಾಹಿತಿಯನ್ನು ಬಳಸುತ್ತೇವೆ, ಉದಾಹರಣೆಗೆ ನಿಮ್ಮ ಖಾತೆಯನ್ನು ರಚಿಸಲು, ನಮ್ಮ ಸೇವೆಗಳನ್ನು - ವೈಯಕ್ತೀಕರಣ ಮತ್ತು ಜಾಹೀರಾತುಗಳನ್ನು ಒಳಗೊಂಡಂತೆ - ಮತ್ತು Snapchat ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಮತ್ತು ಸುಭದ್ರವಾಗಿರಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ. ಖಾತೆ ಮಾಹಿತಿಯನ್ನು ಆ್ಯಕ್ಸೆಸ್‌ ಮಾಡಲು, ನಿರ್ವಹಿಸಲು ಮತ್ತು ಅಳಿಸಲು ಅಥವಾ ನಿಮ್ಮ ಆದ್ಯತೆಗಳನ್ನು ಸರಿಹೊಂದಿಸಲು ನಾವು ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಪರಿಕರಗಳನ್ನು ಒದಗಿಸುತ್ತೇವೆ. \n\nಮುಂದುವರಿಸಿ ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ, ನೀವು %2$@ ಅನ್ನು ಓದಿದ್ದೀರಿ ಮತ್ತು %3$@ ಅನ್ನು ಒಪ್ಪುತ್ತೀರಿ ಎಂದು ನೀವು ಅಂಗೀಕರಿಸುತ್ತೀರಿ.";
