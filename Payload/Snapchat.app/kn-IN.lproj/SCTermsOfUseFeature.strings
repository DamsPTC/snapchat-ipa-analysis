"tos_update_13_acceptance_footer" = "\"ಸಮ್ಮತಿಸಿ ಮತ್ತು ಮುಂದುವರಿಸಿ\" ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ, ನೀವು ನಮ್ಮ ನವೀಕರಿಸಿದ [ಸೇವೆಯ ನಿಯಮಗಳು](https://www.snap.com/terms/), [Snapchat+ ಸಬ್‌ಸ್ಕ್ರಿಪ್ಶನ್‌ ನಿಯಮಗಳು](https://www.snap.com/terms/paid-features), [ ಟೋಕನ್‌ಗಳ ಮಾರಾಟ ಮತ್ತು ಬಳಕೆಯ ನಿಯಮಗಳು](https://www.snap.com/terms/paid-features) ಇವುಗಳನ್ನು ಸಮ್ಮತಿಸುತ್ತೀರಿ ಮತ್ತು ನವೀಕರಿಸಿದ [ಗೌಪ್ಯತಾ ನೀತಿ](https://values.snap.com/privacy/privacy-policy)ಯನ್ನು ನೀವು ಓದಿದ್ದೀರಿ ಎಂದು ಒಪ್ಪಿಕೊಳ್ಳುತ್ತೀರಿ. ಆಗಸ್ಟ್ 15, 2023 ರಿಂದ, ನೀವು ಈ ನವೀಕರಿಸಿದ ನಿಯಮಗಳನ್ನು ಒಪ್ಪದ ಹೊರತು ಮುಂದೆ Snapchat ಅನ್ನು ಬಳಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ.";
"tos_update_13_body" = "ಎಲ್ಲಾ ಬದಲಾವಣೆಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು, ದಯವಿಟ್ಟು ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪೂರ್ಣವಾಗಿ ಓದಿ, ಆದರೆ ನಾವು ಮಾಡಿದ ಕೆಲವು ಪ್ರಮುಖ ಬದಲಾವಣೆಗಳು ಇಲ್ಲಿವೆ:";
"tos_update_13_header" = "👋 ನಾವು ನಮ್ಮ [ಸೇವೆಯ ನಿಯಮಗಳು](https://www.snap.com/terms/), [Snapchat+ ಸಬ್‌ಸ್ಕ್ರಿಪ್ಶನ್ ನಿಯಮಗಳು](https://www.snap.com/terms/paid-features), [ಟೋಕನ್‌ಗಳ ಮಾರಾಟ ಮತ್ತು ಬಳಕೆಯ ನಿಯಮಗಳು](https://www.snap.com/terms/paid-features) ಮತ್ತು [ಗೌಪ್ಯತಾ ನೀತಿ](https://values.snap.com/privacy/privacy-policy)ಯನ್ನು ನವೀಕರಿಸುತ್ತಿದ್ದೇವೆ, ಇದು ಆಗಸ್ಟ್ 15, 2023 ರಿಂದ ಜಾರಿಗೆ ಬರಲಿದೆ.";
"tos_update_13_privacy_content" = " • ನಮ್ಮ ಸೇವೆಗಳನ್ನು ನಾವು ಹೇಗೆ ವೈಯಕ್ತೀಕರಿಸುತ್ತೇವೆ ಎಂಬುದನ್ನು ಒಳಗೊಂಡಂತೆ ಸಂಶೋಧನೆ ನಡೆಸುವುದು ಮತ್ತು ಅಲ್ಗಾರಿದಮ್‌ಗಳು ಮತ್ತು ಯಂತ್ರ ಕಲಿಕೆಯ ಮಾದರಿಗಳನ್ನು ಅಭಿವೃದ್ಧಿಪಡಿಸುವುದು ಸೇರಿದಂತೆ ನಿಮ್ಮ ಮಾಹಿತಿಯನ್ನು ನಾವು ಹೇಗೆ ಬಳಸುತ್ತೇವೆ ಎಂಬುದನ್ನು ಸ್ಪಷ್ಟಪಡಿಸಲಾಗಿದೆ.\n • ನಮ್ಮ [ಗೌಪ್ಯತಾ ಕೇಂದ್ರ](https://values.snap.com/privacy/privacy-center)ದಲ್ಲಿ ಹೊಸ ಪುಟಕ್ಕೆ ಲಿಂಕ್ ಮಾಡಲಾಗಿದ್ದು ಅದು ನಿಮ್ಮ ಡೇಟಾವನ್ನು ನಾವು ಹೇಗೆ ಜಾಹೀರಾತಿಗಾಗಿ ಬಳಸುತ್ತೇವೆ ಎಂಬುದನ್ನು ವಿವರಿಸುತ್ತದೆ ಮತ್ತು ನೀವು ಹೊಂದಿರುವ ಆಯ್ಕೆಗಳನ್ನು ಸ್ಪಷ್ಟಪಡಿಸುತ್ತದೆ.\n • ನಾವು ವಿಷಯವನ್ನು ಹೇಗೆ ಸಂಗ್ರಹಿಸುತ್ತೇವೆ ಮತ್ತು ಬಳಸುತ್ತೇವೆ ಎಂಬುದರ ಕುರಿತು ಹೆಚ್ಚಿನ ಪಾರದರ್ಶಕತೆಯನ್ನು ಒದಗಿಸಲಾಗಿದೆ. ಉದಾಹರಣೆಗೆ, ನೀವು ಸ್ಪಾಟ್‌ಲೈಟ್‌ಗೆ ಬಾಸ್ಕೆಟ್‌ಬಾಲ್ ವೀಡಿಯೊಗಳನ್ನು ಪೋಸ್ಟ್ ಮಾಡಿದರೆ ನಾವು ನಿಮಗೆ ಹೆಚ್ಚಿನ ಬಾಸ್ಕೆಟ್‌ಬಾಲ್ ವಿಷಯವನ್ನು ತೋರಿಸಬಹುದು.";
"tos_update_13_terms_content" = " • U.S. ಕಡ್ಡಾಯ ಮಧ್ಯಸ್ಥಿಕೆಯ ಕರಾರು, ಸಮೂಹ ಕ್ರಮ ಮತ್ತು ತೀರ್ಪುಗಾರರ ವಿಚಾರಣೆ ಮನ್ನಾವನ್ನು ನವೀಕರಿಸಲಾಗಿದೆ ಮತ್ತು ಅನೌಪಚಾರಿಕ ವಿವಾದ ಪರಿಹಾರದ ನಿಬಂಧನೆಯನ್ನು ಸೇರಿಸಲಾಗಿದೆ.\n • ನಮ್ಮ ನಿಯಮಗಳಿಗೆ ನಾವು ಯಾವಾಗ ಬದಲಾವಣೆಗಳನ್ನು ಮಾಡುತ್ತೇವೆ ಮತ್ತು ಈ ಬದಲಾವಣೆಗಳ ಕುರಿತು ನಾವು ನಿಮಗೆ ಯಾವಾಗ ತಿಳಿಸುತ್ತೇವೆ ಎಂಬುದನ್ನು ಸ್ಪಷ್ಟಪಡಿಸಲಾಗಿದೆ.\n • ಯುರೋಪಿಯನ್ ಡಿಜಿಟಲ್ ಸೇವೆಗಳ ಕಾಯ್ದೆಯ ಅವಶ್ಯಕತೆಗಳನ್ನು ಪೂರೈಸಲು ಸಹಾಯ ಮಾಡಲು, ನಾವು ವೈಯಕ್ತೀಕರಣ, ಕಂಟೆಂಟ್‌ ಹತೋಟಿಯಲ್ಲಿರಿಸುವಿಕೆ ಮತ್ತು ಬಳಕೆಯ ನಿಯಮಗಳ ಜಾರಿಯ ಬಗ್ಗೆ ನಮ್ಮ ವಿಧಾನದ ಕುರಿತು ಹೆಚ್ಚುವರಿ ಮಾಹಿತಿಯನ್ನು ಒದಗಿಸಿದ್ದೇವೆ.";
"tos_update_14_acceptance_footer" = "\"ಒಪ್ಪಿಕೊಳ್ಳಿ ಮತ್ತು ಮುಂದುವರಿಯಿರಿ\" ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ, ನೀವು ನಮ್ಮ ಅಪ್‌ಡೇಟ್ ಮಾಡಿದ [ಸೇವೆಯ ನಿಯಮಗಳು](https://www.snap.com/terms) ಮತ್ತು [ಪಾವತಿಸಿದ ವೈಶಿಷ್ಟ್ಯಗಳ ನಿಯಮಗಳು](https://snap.com/terms/paid-features) ಅನ್ನು ಒಪ್ಪಿಕೊಳ್ಳುತ್ತೀರಿ ಹಾಗೂ ನಮ್ಮ ಅಪ್‌ಡೇಟ್ ಮಾಡಿದ [ಗೌಪ್ಯತಾ ನೀತಿ](https://values.snap.com/privacy/privacy-policy) ಅನ್ನು ಓದಿದ್ದೀರಿ ಎಂದು ಅಂಗೀಕರಿಸುತ್ತೀರಿ. ಫೆಬ್ರವರಿ 26, 2024 ರಿಂದ, ನೀವು ಈ ಅಪ್‌ಡೇಟ್ ಮಾಡಿದ ನಿಯಮಗಳನ್ನು ಒಪ್ಪದ ಹೊರತು, ಮುಂದೆ Snapchat ಅನ್ನು ಬಳಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ.";
"tos_update_14_body" = "ಎಲ್ಲಾ ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ದಯವಿಟ್ಟು ಪೂರ್ಣವಾಗಿ ಓದಿ, ಆದರೆ ನಾವು ಮಾಡಿದ ಕೆಲವು ಪ್ರಮುಖ ಬದಲಾವಣೆಗಳು ಇಲ್ಲಿವೆ:";
"tos_update_14_header" = "ನಮ್ಮ [ಗೌಪ್ಯತಾ ನೀತಿ](https://values.snap.com/privacy/privacy-policy) ಮತ್ತು [ಸೇವೆಯ ನಿಯಮಗಳು](https://www.snap.com/terms) ಅನ್ನು ನಾವು ಅಪ್‌ಡೇಟ್ ಮಾಡುತ್ತಿದ್ದೇವೆ, ಇವು ಫೆಬ್ರವರಿ 26, 2024 ರಂದು ಜಾರಿಗೆ ಬರಲಿವೆ.";
"tos_update_14_india_blurb" = "ಎಲ್ಲಾ Snapchatter ಗಳು ನಮ್ಮ ಸೇವೆಯ ನಿಯಮಗಳಿಗೆ ಬದ್ಧರಾಗಬೇಕು, ಇವು ನಮ್ಮ [ಕಮ್ಯುನಿಟಿ ಮಾರ್ಗಸೂಚಿಗಳು](https://values.snap.com/privacy/transparency/community-guidelines) ಅನ್ನೂ ಒಳಗೊಂಡಿವೆ. ನೀವು Snapchat ಅನ್ನು ಕಾನೂನುಬಾಹಿರ ಉದ್ದೇಶಗಳಿಗೆ ಬಳಸಬಾರದಾಗಿದ್ದು, ಭಾರತದಲ್ಲಿ ಇದು ಭಾರತೀಯ ಐಟಿ ನಿಯಮಗಳು 2021 ಅನ್ನು ಉಲ್ಲಂಘಿಸುವ ಕಂಟೆಂಟ್ ಅನ್ನು ಕಳುಹಿಸಲು ಅಥವಾ ಪೋಸ್ಟ್ ಮಾಡಲು Snapchat ಅನ್ನು ಬಳಸದೇ ಇರುವುದನ್ನೂ ಒಳಗೊಂಡಿದೆ. \n\n";
"tos_update_14_privacy_content" = " • ನೀತಿಯ ಪ್ರತಿ ವಿಭಾಗವನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವುದನ್ನು ಸುಲಭಗೊಳಿಸಲು, ಅವುಗಳಿಗೆ ಸಾರಾಂಶಗಳನ್ನು ಸೇರಿಸಲಾಗಿದೆ.\n •  ನಿಮ್ಮ ಡೇಟಾ ಡೌನ್‌ಲೋಡ್ ಮಾಡುವುದು, ನೀವು ಯಾರೊಂದಿಗೆ ಕಂಟೆಂಟ್ ಹಂಚಿಕೊಳ್ಳುತ್ತೀರಿ ಮತ್ತು ಯಾರು ನಿಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಬಹುದು ಎಂಬದನ್ನು ಒಳಗೊಂಡಂತೆ ನಿಮ್ಮ ಮಾಹಿತಿಯನ್ನು ನೀವು ಹೇಗೆ ನಿಯಂತ್ರಿಸಬಹುದು ಎಂಬುದರ ಕುರಿತು ಹೆಚ್ಚಿನ ವಿವರ.\n • ನಿಮ್ಮ ಮಾಹಿತಿ ಮತ್ತು ಕಂಟೆಂಟ್ ಅನ್ನು ನಾವು ಹೇಗೆ ಸಂಗ್ರಹಿಸುತ್ತೇವೆ ಮತ್ತು ಬಳಸುತ್ತೇವೆ ಎಂಬುದರ ಕುರಿತು ಹೆಚ್ಚಿನ ಪಾರದರ್ಶಕತೆ. ವೈಯಕ್ತೀಕರಣ, ಜಾಹೀರಾತು ಉದ್ದೇಶಗಳಿಗಾಗಿ ಮತ್ತು ಯಂತ್ರ ಕಲಿಕೆ ಮಾದರಿಗಳ ನಿರ್ಮಾಣಕ್ಕೆ ನಾವು ಯಾವ ಡೇಟಾ ಬಳಸುತ್ತೇವೆ ಎಂಬುದರ ಉದಾಹರಣೆಗಳನ್ನೂ ಇದು ಒಳಗೊಂಡಿದೆ.";
"tos_update_14_terms_content" = " • ಮುಂದುವರಿದು, Snap ಒಂದು ವೈಯಕ್ತೀಕರಿಸಿದ ಸೇವೆ ಎಂಬುದನ್ನು ಸ್ಪಷ್ಟಪಡಿಸಲಾಗಿದೆ.\n •ನೀವು ಏಷ್ಯಾ-ಪೆಸಿಫಿಕ್ ಪ್ರಾಂತ್ಯದಲ್ಲಿ ವಾಸಿಸುತ್ತಿದ್ದರೆ, Snap Group Limited ಸಿಂಗಾಪುರ ಶಾಖೆಯು ನಿಮಗೆ ಸೇವೆಗಳನ್ನು ಒದಗಿಸುವ ಜವಾಬ್ದಾರಿ ಹೊಂದಿದೆ.\n • Snapchat+, ಟೋಕನ್‌ಗಳು ಮತ್ತು ಸ್ಟ್ರೀಕ್ ರಿಸ್ಟೋರ್ ಇವುಗಳಿಗಾಗಿನ ನಿಯಮಗಳನ್ನು ಈಗ ಹೊಸ [ಪಾವತಿಸಿದ ವೈಶಿಷ್ಟ್ಯ ನಿಯಮಗಳಲ್ಲಿ](https://snap.com/terms/paid-features) ಸೇರಿಸಲಾಗಿದೆ.";
