<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Snapchat</string>
	<key>CFBundleName</key>
	<string>Snapchat</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>This will allow Snapchat to connect to Bluetooth accessories such as Spectacles.</string>
	<key>NSCameraUsageDescription</key>
	<string>Use your camera to take Snaps, play with Lenses and more! Some Lenses may use Apple’s TrueDepth camera. See our Privacy Policy for more information.</string>
	<key>NSContactsUsageDescription</key>
	<string>Your contacts will be uploaded to Snapchat’s servers so that you and others can find friends, and to improve your experience.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>This will allow Snapchat to connect to Wi-Fi enabled accessories like Spectacles.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Selecting “Always Allow” will let Snapchat update your location in the background to share Live Location and improve your experience.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Selecting “Always Allow” will let Snapchat update your location in the background to share Live Location and improve your experience.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Snapchat uses this to customise your experience and let you discover Filters, Stories and more around you.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Use your microphone to record audio for Snaps, video chat and more.</string>
	<key>NSMotionUsageDescription</key>
	<string>Snapchat records whether your device is vertical or horizontal when you take Snaps, use Lenses, read Discover and watch ads.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Share your Camera Roll content with friends on Snap.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Share your Camera Roll content with friends on Snap.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>By selecting “Allow”, Snap may reduce the ads you find irrelevant or repetitive over time. See our Privacy Policy for more information about Tracking.</string>
</dict>
</plist>
