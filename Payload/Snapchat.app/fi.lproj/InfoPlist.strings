<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Snapchat</string>
	<key>CFBundleName</key>
	<string>Snapchat</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Tämän avulla Snapchat voi muodostaa yhteyden Bluetooth-lisälaitteisiin, kuten Spectacleseihin.</string>
	<key>NSCameraUsageDescription</key>
	<string>Käytä kameraa ottamaan Snappeja, tehosteiden kokeiluun ja paljon muuhun! Jotkut tehosteet voivat käyttää Applen TrueDepth-kameraa. Katso lisätietoja tietosuojaselosteestamme.</string>
	<key>NSContactsUsageDescription</key>
	<string>Yhteystietosi ladataan Snapchatin palvelimille, jotta sinä ja muut löydätte kavereita ja jotta käyttäjäkokemus olisi parempi.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tämän avulla Snapchat voi muodostaa yhteyden Wi-Fin välityksellä toimiviin lisälaitteisiin, kuten Spectacleseihin.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Salli aina -vaihtoehdon valitseminen antaa Snapchatin päivittää sijaintiasi taustalla sen jakamista ja käyttökokemuksesi parantamista varten.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Salli aina -vaihtoehdon valitseminen antaa Snapchatin päivittää sijaintiasi taustalla sen jakamista ja käyttökokemuksesi parantamista varten.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Käytämme tätä kokemuksesi räätälöintiin. Sen avulla voit löytää suodattimia, tarinoita ja muuta ympäriltäsi.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Käytä mikrofonia esimerkiksi Snappien äänen tallentamiseen ja videochattiin.</string>
	<key>NSMotionUsageDescription</key>
	<string>Snapchat tallentaa tiedon siitä, onko laitteesi pysty- vai vaaka-asennossa, kun otat Snappeja, käytät tehosteita, luet Tutustu-osiota tai katsot mainoksia.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Jaa kamerasi rullan sisältöä Snapchat-kavereillesi.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Jaa kamerasi rullan sisältöä Snapchat-kavereillesi.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>Kun sallit toiminnon, Snap voi vähentää epäolennaisiksi tai toistuviksi kokemiesi mainosten määrää vähitellen. Lue lisätietoja seurannasta tietosuojaselosteestamme.</string>
</dict>
