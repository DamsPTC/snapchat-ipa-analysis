"user_agreement_linking_EuUk_t1" = "വ്യക്തിപരമാക്കിയ സേവനമാണ് Snapchat. നിങ്ങൾ ഇത് ഉപയോഗിക്കുന്നതിന്റെ അടിസ്ഥാനത്തിൽ ഞങ്ങൾ നിങ്ങളെ കാര്യങ്ങൾ കാണിക്കുന്നു. നിങ്ങളെ വ്യക്തിപരമാക്കിയ പരസ്യങ്ങൾ കാണിക്കാൻ ഞങ്ങൾ ചില വിവരങ്ങളും (മറ്റുള്ളവർ നൽകിയേക്കാവുന്ന വിവരങ്ങളും) ഉപയോഗിക്കുന്നു, ഞങ്ങളുടെ കമ്മ്യൂണിറ്റിക്ക് പണം നൽകാതെ തന്നെ Snapchat ഉപയോഗിക്കാൻ ഇത്തരത്തിൽ പരസ്യങ്ങൾ കാണിക്കുന്നതിലൂടെ കഴിയുന്നു. [%1$@]\n\nതുടരുക ടാപ്പ് ചെയ്യുന്നതിലൂടെ, %2$@ വായിച്ചതായി നിങ്ങൾ സമ്മതിക്കുകയും %3$@ അംഗീകരിക്കുകയും ചെയ്യുന്നു.";
"user_agreement_linking_EuUk_t2" = "തുടരുക ടാപ്പ് ചെയ്യുന്നതിലൂടെ, നിങ്ങൾ %1$@ വായിച്ചതായി സമ്മതിക്കുകയും %2$@ അംഗീകരിക്കുകയും ചെയ്യുന്നു.\n\nനിങ്ങൾ ഉപയോഗിക്കുന്നതിന്റെ അടിസ്ഥാനത്തിൽ നിങ്ങളെ ഉള്ളടക്കവും പരസ്യങ്ങളും കാണിക്കുന്ന വ്യക്തിപരമാക്കിയ സേവനമാണ് Snapchat.";
"user_agreement_linking_Quebec" = "ഞങ്ങളുടെ സ്വകാര്യതാ നയം, %1$@) എന്നിവയിൽ വിവരിച്ചിരിക്കുന്നത് പോലെ, നിങ്ങളുടെ അക്കൗണ്ട് സൃഷ്ടിക്കുക, ഞങ്ങളുടെ സേവനങ്ങൾ നൽകുക (വ്യക്തിപരമാക്കലും പരസ്യങ്ങളും ഉൾപ്പെടെ), Snapchat-നെ സുരക്ഷിതവും പരിരക്ഷിതവുമായി നിലനിർത്തുക എന്നിവ പോലുള്ള കാര്യങ്ങൾക്കായി ഞങ്ങൾ നിങ്ങളുടെ വിവരങ്ങൾ ഉപയോഗിക്കും. അക്കൗണ്ട് വിവരങ്ങൾ ആക്സസ് ചെയ്യാനും മാനേജ് ചെയ്യാനും ഇല്ലാതാക്കാനും ഉള്ള ടൂളുകൾ ഞങ്ങൾ നിങ്ങളുടെ ആപ്പ് ക്രമീകരണത്തിൽ നൽകുന്നു, അല്ലെങ്കിൽ നിങ്ങളുടെ മുൻഗണനകൾ ക്രമീകരിക്കാം.\n\nതുടരുക ടാപ്പ് ചെയ്യുന്നതിലൂടെ നിങ്ങൾ %2$@ വായിച്ചതായി സമ്മതിക്കുകയും %3$@ അംഗീകരിക്കുകയും ചെയ്യുന്നു.";
