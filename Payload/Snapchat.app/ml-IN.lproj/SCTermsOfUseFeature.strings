"tos_update_13_acceptance_footer" = "“അംഗീകരിച്ച് തുടരുക” ടാപ്പ് ചെയ്യുന്നതിലൂടെ നിങ്ങൾ ഞങ്ങളുടെ അപ്ഡേറ്റ് ചെയ്ത [സേവന നിബന്ധനകൾe](https://www.snap.com/terms/), [Snapchat+ സബ്സ്ക്രിപ്ഷൻ നിബന്ധനകൾ](https://www.snap.com/terms/paid-features), [Tokens-ന്റെ വിൽപ്പനയും ഉപയോഗവുമായി ബന്ധപ്പെട്ട നിബന്ധനകൾ](https://www.snap.com/terms/paid-features) എന്നിവ അംഗീകരിക്കുകയും അപ്ഡേറ്റ് ചെയ്ത [സ്വകാര്യതാ നയം](https://values.snap.com/privacy/privacy-policy) വായിച്ചുവെന്ന് സമ്മതിക്കുകയും ചെയ്യുന്നു. അപ്ഡേറ്റ് ചെയ്ത ഈ നിബന്ധനകൾ നിങ്ങൾ അംഗീകരിച്ചില്ലെങ്കിൽ 2023 ഓഗസ്റ്റ് 15 മുതൽ നിങ്ങൾക്ക് Snapchat ഉപയോഗിക്കാനാകില്ല.";
"tos_update_13_body" = "എല്ലാ മാറ്റങ്ങളും മനസ്സിലാക്കാൻ അപ്ഡേറ്റുകൾ പൂർണ്ണമായും വായിക്കുക, എന്നാൽ ഞങ്ങൾ വരുത്തിയ പ്രധാനപ്പെട്ട ചില മാറ്റങ്ങൾ ഇവിടെ കാണാം:";
"tos_update_13_header" = "👋 ഞങ്ങളുടെ [സേവന നിബന്ധനകൾ](https://www.snap.com/terms/), [Snapchat+ സബ്സ്ക്രിപ്ഷൻ നിബന്ധനകൾ](https://www.snap.com/terms/paid-features), [Tokens-ന്റെ വിൽപ്പനയും ഉപയോഗവുമായി ബന്ധപ്പെട്ട നിബന്ധനകൾ](https://www.snap.com/terms/paid-features), [സ്വകാര്യതാ നയം](https://values.snap.com/privacy/privacy-policy) എന്നിവ ഞങ്ങൾ അപ്ഡേറ്റ് ചെയ്യുകയാണ്, അവ 2023 ഓഗസ്റ്റ് 15 -ന് പ്രാബല്യത്തിൽ വരും.";
"tos_update_13_privacy_content" = " • ഞങ്ങളുടെ സേവനങ്ങൾ വ്യക്തിപരമാക്കുന്നതും ഗവേഷണം നടത്തുന്നതും എങ്ങനെ, അൽഗരിതവും മെഷീൻ ലേണിംഗ് മോഡലുകളും എങ്ങനെ വികസിപ്പിക്കുന്നു എന്നിവ ഉൾപ്പെടെ, ഞങ്ങൾ നിങ്ങളുടെ വിവരങ്ങൾ ഉപയോഗിക്കുന്ന രീതിയെ കുറിച്ച് വ്യക്തമാക്കി.\n • പരസ്യത്തിനായി നിങ്ങളുടെ ഡാറ്റ ഞങ്ങൾ എങ്ങനെ ഉപയോഗിക്കുന്നുവെന്ന് വിശദീകരിക്കുകയും നിങ്ങൾക്കുള്ള ചോയിസുകൾ വ്യക്തമാക്കുകയും ചെയ്യുന്ന ഒരു പേജിലേക്കുള്ള ലിങ്ക് ഞങ്ങളുടെ [സ്വകാര്യതാ കേന്ദ്രത്തിൽ](https://values.snap.com/privacy/privacy-center) ചേർത്തു.\n • ഞങ്ങൾ ഉള്ളടക്കം ഉപയോഗിക്കുന്നതും ശേഖരിക്കുന്നതും എങ്ങനെ എന്നത് സംബന്ധിച്ച് കൂടുതൽ സുതാര്യത നൽകി. ഉദാഹരണത്തിന്, നിങ്ങൾ സ്‌പോട്ട്‌ലൈറ്റിലേക്ക് ബാസ്‌ക്കറ്റ്‌ബോൾ കളിക്കുന്നതിന്റെ വീഡിയോകൾ പോസ്റ്റ് ചെയ്യുകയാണെങ്കിൽ ഞങ്ങൾ ബാസ്‌ക്കറ്റ്‌ബോളുമായി ബന്ധപ്പെട്ട കൂടുതൽ ഉള്ളടക്കം നിങ്ങളെ കാണിച്ചേക്കാം.";
"tos_update_13_terms_content" = " • യുഎസിന്റെ നിർബന്ധിത ആർബിട്രേഷൻ ഉടമ്പടി, കൂട്ടായ നിയമനടപടി, ജൂറി ട്രയൽ എഴുതിത്തള്ളൽ എന്നിവ അപ്ഡേറ്റ് ചെയ്തു, തർക്കപരിഹാരത്തിനുള്ള ഒരു അനൗദ്യോഗിക വ്യവസ്ഥ ചേർത്തു.\n • ഞങ്ങളുടെ നിബന്ധകളിൽ എപ്പോഴൊക്കെ മാറ്റങ്ങൾ വരുത്തുമെന്നും ഈ മാറ്റങ്ങളേക്കുറിച്ച് എപ്പോൾ നിങ്ങളെ അറിയിക്കുമെന്നും വ്യക്തമാക്കി.\n • യൂറോപ്യൻ ഡിജിറ്റൽ സേവന നിയമത്തിലെ ആവശ്യകതകൾ പാലിക്കാൻ സഹായിക്കുന്നതിന് ഞങ്ങൾ വ്യക്തിപരമാക്കൽ, ഉള്ളടക്ക മോഡറേഷൻ, സേവന നിബന്ധനകൾ നടപ്പാക്കുന്നതുമായി ബന്ധപ്പെട്ട ഞങ്ങളുടെ സമീപനം എന്നിവയെ കുറിച്ചുള്ള അധിക വിവരങ്ങൾ നൽകി.";
"tos_update_14_acceptance_footer" = "“അംഗീകരിച്ച് തുടരുക” ടാപ്പ് ചെയ്യുന്നതിലൂടെ നിങ്ങൾ ഞങ്ങളുടെ അപ്ഡേറ്റ് ചെയ്ത [സേവന വ്യവസ്ഥകൾ](https://www.snap.com/terms), [പെയ്ഡ് ഫീച്ചർ നിബന്ധനകൾ](https://snap.com/terms/paid-features) എന്നിവ അംഗീകരിക്കുകയും അപ്ഡേറ്റ് ചെയ്ത [സ്വകാര്യതാ നയം](https://values.snap.com/privacy/privacy-policy) വായിച്ചുവെന്ന് സമ്മതിക്കുകയും ചെയ്യുന്നു. അപ്ഡേറ്റ് ചെയ്ത ഈ നിബന്ധനകൾ നിങ്ങൾ അംഗീകരിച്ചില്ലെങ്കിൽ 2024 ഫെബ്രുവരി 26 മുതൽ നിങ്ങൾക്ക് Snapchat ഉപയോഗിക്കാനാകില്ല.";
"tos_update_14_body" = "അപ്ഡേറ്റുകൾ പൂർണ്ണമായും വായിക്കുക, എന്നാൽ ഞങ്ങൾ വരുത്തിയ പ്രധാനപ്പെട്ട ചില മാറ്റങ്ങൾ ഇവിടെ കാണാം:";
"tos_update_14_header" = "ഞങ്ങളുടെ [സ്വകാര്യതാ നയം](https://values.snap.com/privacy/privacy-policy),  [സേവന വ്യവസ്ഥകൾ](https://www.snap.com/terms) എന്നിവ അപ്ഡേറ്റ് ചെയ്യുകയാണ്, അവ 2024 ഫെബ്രുവരി 26-ന് പ്രാബല്യത്തിൽ വരും.";
"tos_update_14_india_blurb" = "എല്ലാ സ്നാപ്പ്ചാറ്റർമാരും [കമ്മ്യൂണിറ്റി മാർഗ്ഗനിർദ്ദേശങ്ങൾ](https://values.snap.com/privacy/transparency/community-guidelines) ഉൾപ്പെടെയുള്ള ഞങ്ങളുടെ സേവന വ്യവസ്ഥകൾ അനുസരിക്കണം. അനധികൃത കാര്യങ്ങൾക്കായി നിങ്ങൾ Snapchat ഉപയോഗിക്കരുത്, അവയിൽ ഇന്ത്യയിൽ, ഇന്ത്യൻ ഐടി ചട്ടങ്ങൾ 2021 ലംഘിക്കുന്ന ഉള്ളടക്കം അയയ്ക്കാനോ പോസ്റ്റ് ചെയ്യാനോ Snapchat ഉപയോഗിക്കുന്നത് ഉൾപ്പെടുന്നു.\n\n";
"tos_update_14_privacy_content" = " • എളുപ്പത്തിൽ മനസ്സിലാക്കാൻ നയത്തിന്റെ ഓരോ വിഭാഗത്തിലും സംഗ്രഹങ്ങൾ ചേർത്തു.\n • നിങ്ങളുടെ ഡാറ്റ ഡൗൺലോഡ് ചെയ്യുന്നത്, ആരുമായി നിങ്ങൾ ഉള്ളടക്കം പങ്കിടുന്നു, ആർക്കൊക്കെ നിങ്ങളെ ബന്ധപ്പെടാം എന്നിവ ഉൾപ്പെടെ, നിങ്ങളുടെ വിവരങ്ങൾ എങ്ങനെ നിയന്ത്രിക്കാം എന്നതിനെക്കുറിച്ചുള്ള കൂടുതൽ വിശദാംശങ്ങൾ.\n • വ്യക്തിപരമാക്കൽ, പരസ്യം ചെയ്യൽ, മെഷീൻ ലേണിംഗ് മോഡലുകൾ നിർമ്മിക്കൽ തുടങ്ങിയ കാര്യങ്ങൾക്കായി ഞങ്ങൾ ഉപയോഗിക്കുന്ന ഡാറ്റയുടെ ഉദാഹരണങ്ങൾ സഹിതം ഉൾപ്പെടുത്തി, നിങ്ങളുടെ വിവരങ്ങളും ഉള്ളടക്കവും ഞങ്ങൾ എങ്ങനെ ശേഖരിക്കുകയും ഉപയോഗിക്കുകയും ചെയ്യുന്നു എന്നതിനെക്കുറിച്ച് കൂടുതൽ സുതാര്യത നൽകിയിരിക്കുന്നു.";
"tos_update_14_terms_content" = " • Snap ഒരു വ്യക്തിഗത സേവനമാണെന്ന് കൂടുതൽ വ്യക്തമാക്കുന്നു.\n • നിങ്ങൾ ഏഷ്യാ-പസഫിക് മേഖലയിലാണ് താമസിക്കുന്നതെങ്കിൽ, നിങ്ങൾക്ക് സേവനങ്ങൾ നൽകുന്നതിന്റെ ഉത്തരവാദിത്തം Snap Group Limited Singapore ബ്രാഞ്ചിനാണ്.\n • Snapchat+, Tokens, സ്ട്രീക്ക് റീസ്റ്റോർ എന്നിവയ്ക്കുള്ള നിബന്ധനകൾ ഇപ്പോൾ പുതിയ [പെയ്ഡ് ഫീച്ചർ നിബന്ധനകൾ](https://snap.com/terms/paid-features) എന്നതിൽ ഉൾപ്പെടുത്തിയിരിക്കുന്നു ";
